# Checkpoint backend environment
# Copy to .env and adjust values before running.

# SQLAlchemy connection string. Default: local SQLite file.
DATABASE_URL=sqlite:///./checkpoint.db

# JWT signing key. CHANGE THIS in production. Recommend `openssl rand -hex 32`.
SECRET_KEY=dev-secret-key-change-in-production

# JWT signing algorithm.
ALGORITHM=HS256

# Token lifetime in minutes (1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
